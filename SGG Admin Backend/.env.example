# Port the admin server listens on
PORT=4000

# Absolute path to the live static website that Publish overwrites.
# Both projects now live side by side under "SGG Parent Directory", so the
# built-in default (the sibling "SGG Website" folder) already resolves
# correctly and this line can be left commented out.
SITE_ROOT=/Users/capi/Library/CloudStorage/Dropbox/SGG Parent Directory/SGG Website

# Sign session cookies. Change this to a long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# Public origin of THIS admin server, baked into the tracker snippet that
# published pages load. Must be reachable from wherever the site is hosted.
PUBLIC_ORIGIN=http://localhost:4000

# Origins allowed to post analytics and form submissions. Comma separated,
# or * to allow any. Lock this down once the site has a real domain.
TRACKING_ORIGINS=*

NODE_ENV=development
