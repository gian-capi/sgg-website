<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd agent for the SGG Admin server.

  Install:   ./deploy/install.sh
  Status:    launchctl print gui/$(id -u)/co.sgg.admin
  Logs:      tail -f logs/admin.log logs/admin.error.log
  Stop:      launchctl bootout gui/$(id -u)/co.sgg.admin

  Paths are absolute because launchd does not expand ~ or run a login shell.
  install.sh rewrites them for the machine it runs on.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>co.sgg.admin</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__APP_DIR__/server.js</string>
  </array>

  <!-- config.js resolves data/, uploads/ and backups/ relative to this. -->
  <key>WorkingDirectory</key>
  <string>__APP_DIR__</string>

  <key>RunAtLoad</key>
  <true/>

  <!-- Restart if the process exits for any reason. -->
  <key>KeepAlive</key>
  <true/>

  <!-- Do not spin on a crash loop: wait 10s between restarts. -->
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>__APP_DIR__/logs/admin.log</string>
  <key>StandardErrorPath</key>
  <string>__APP_DIR__/logs/admin.error.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd's PATH is minimal; sharp and better-sqlite3 want a real one. -->
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <!-- Everything else is read from .env by src/lib/config.js. -->
  </dict>

  <key>ProcessType</key>
  <string>Interactive</string>
</dict>
</plist>
